 "html": {
  "ef27b9de34d0814e": "<main class=\"shot\" data-bd=\"today\">\n  <h1 class=\"shot-cap\" data-bd=\"cap\" data-l10n=\"today.title\">See your week at a glance</h1>\n  <div class=\"shot-frame\" data-bd=\"frame\">\n    <div class=\"shot-ui\" data-bd=\"ui\">\n      <main class=\"screen safe stack gap-4\" data-bd=\"screen\">\n        <header class=\"row between\" data-bd=\"greeting\">\n          <div class=\"stack gap-1\"><span class=\"caption muted\">Saturday 10 October</span><h2 class=\"title\">This week</h2></div>\n          <span class=\"avatar\" data-bd=\"avatar\">AF</span>\n        </header>\n        <section class=\"card stack center gap-3\" data-bd=\"steps\" data-callout>\n          <div class=\"ring\" style=\"--v:.72; --size: 168px; --thick: 14px\"><div class=\"stack center\"><span class=\"num\" style=\"font-size:34px\">51,214</span><span class=\"caption muted\">of 70,000 steps</span></div></div>\n          <span class=\"badge ok\">72% of the week's goal</span>\n        </section>\n        <section class=\"grid cols-3 gap-3\" data-bd=\"stats\">\n          <div class=\"card kpi\"><span class=\"label\">Runs</span><span class=\"num\">4</span><span class=\"caption muted\">this week</span></div>\n          <div class=\"card kpi\"><span class=\"label\">Rides</span><span class=\"num\">2</span><span class=\"caption muted\">this week</span></div>\n          <div class=\"card kpi\"><span class=\"label\">Sleep</span><span class=\"num\">7.4</span><span class=\"caption muted\">h a night</span></div>\n        </section>\n        <section class=\"card stack gap-2\" data-bd=\"days\">\n          <span class=\"label\">Active minutes</span>\n          <div class=\"row gap-2\" style=\"align-items:flex-end; height:72px\">\n            <i style=\"flex:1; height:40%; background:var(--accent); border-radius:4px\"></i><i style=\"flex:1; height:70%; background:var(--accent); border-radius:4px\"></i>\n            <i style=\"flex:1; height:55%; background:var(--accent); border-radius:4px\"></i><i style=\"flex:1; height:90%; background:var(--accent); border-radius:4px\"></i>\n            <i style=\"flex:1; height:30%; background:var(--accent); border-radius:4px\"></i><i style=\"flex:1; height:80%; background:var(--accent); border-radius:4px\"></i>\n            <i style=\"flex:1; height:62%; background:var(--accent); border-radius:4px; opacity:.5\"></i>\n          </div>\n        </section>\n      </main>\n    </div>\n  </div>\n</main>\n",
  "5aa5afa7bc893993": "<main class=\"shot\" data-bd=\"workout\">\n  <h1 class=\"shot-cap\" data-bd=\"cap\" data-l10n=\"workout.title\">Every run, mapped</h1>\n  <div class=\"shot-frame\" data-bd=\"frame\">\n    <div class=\"shot-ui\" data-bd=\"ui\">\n      <main class=\"screen safe stack gap-4\" data-bd=\"screen\">\n        <header class=\"stack gap-1\" data-bd=\"head\"><span class=\"caption muted\">Morning run</span><h2 class=\"title\">5.0 km</h2></header>\n        <section class=\"card\" data-bd=\"map\" style=\"height:260px; padding:0; overflow:hidden; background:#e8f0e6\">\n          <svg viewBox=\"0 0 300 260\" width=\"100%\" height=\"100%\" aria-hidden=\"true\"><path d=\"M0 70 L300 40 M0 180 L300 210 M90 0 L120 260 M210 0 L190 260\" stroke=\"#fff\" stroke-width=\"10\"/>\n            <path d=\"M40 210 C70 150 60 110 110 95 S190 120 200 70 S250 40 262 60\" fill=\"none\" stroke=\"#1d4ed8\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n            <circle cx=\"40\" cy=\"210\" r=\"8\" fill=\"#16a34a\"/><circle cx=\"262\" cy=\"60\" r=\"8\" fill=\"#dc2626\"/></svg>\n        </section>\n        <section class=\"grid cols-3 gap-3\" data-bd=\"stats\" data-callout>\n          <div class=\"card kpi\"><span class=\"label\">Time</span><span class=\"num\">26:41</span></div>\n          <div class=\"card kpi\"><span class=\"label\">Pace</span><span class=\"num\">5:20</span><span class=\"caption muted\">/km</span></div>\n          <div class=\"card kpi\"><span class=\"label\">Heart</span><span class=\"num\">148</span><span class=\"caption muted\">bpm</span></div>\n        </section>\n        <button class=\"btn primary block\" data-bd=\"share\">Share the run</button>\n      </main>\n    </div>\n  </div>\n</main>\n",
  "0720801ff72a6816": "<main class=\"shot\" data-bd=\"streak\">\n  <h1 class=\"shot-cap\" data-bd=\"cap\" data-l10n=\"streak.title\">Keep the streak going</h1>\n  <div class=\"shot-frame\" data-bd=\"frame\">\n    <div class=\"shot-ui\" data-bd=\"ui\">\n      <main class=\"screen safe stack gap-4 center\" data-bd=\"screen\">\n        <span class=\"label\" data-bd=\"label\">Current streak</span>\n        <span class=\"num\" data-bd=\"days\" data-callout style=\"font-size:96px; line-height:1; color:var(--accent)\">23</span>\n        <span class=\"headline\">days in a row</span>\n        <section class=\"card stack gap-2\" data-bd=\"weeks\" style=\"width:100%\">\n          <div class=\"row between\"><span>This week</span><span class=\"badge ok\">7 / 7</span></div>\n          <div class=\"row between\"><span>Last week</span><span class=\"badge ok\">7 / 7</span></div>\n          <div class=\"row between\"><span>Best streak</span><span class=\"num\">41</span></div>\n        </section>\n        <button class=\"btn primary block\" data-bd=\"remind\">Remind me at 7:00</button>\n      </main>\n    </div>\n  </div>\n</main>\n",
  "0c9817206e1357f3": "<main class=\"shot\" data-bd=\"watch-rings\">\n  <div class=\"shot-frame\" data-bd=\"frame\">\n    <div class=\"shot-ui\" data-bd=\"ui\" style=\"background:#000; color:#fff\">\n      <main class=\"screen stack gap-2 center\" data-bd=\"screen\" style=\"background:#000; color:#fff; height:100%\">\n        <div class=\"ring\" data-bd=\"ring\" style=\"--v:.72; --size: 132px; --thick: 14px; --accent:#22c55e; --bg:#000\"><div class=\"stack center\"><span class=\"num\" style=\"font-size:26px; color:#fff\">7,214</span><span class=\"caption\" style=\"color:#a3a3a3\">steps</span></div></div>\n        <span class=\"caption\" data-bd=\"goal\" style=\"color:#a3a3a3\">72% of today</span>\n      </main>\n    </div>\n  </div>\n</main>\n",
  "61e9ad175fd67f38": "<main class=\"asset\" data-bd=\"feature\" style=\"justify-content:center; text-align:center; background:linear-gradient(110deg, var(--brand-bg), color-mix(in oklch, var(--brand-bg), var(--brand-accent) 35%))\">\n  <div class=\"stack gap-2\" data-bd=\"copy\">\n    <h1 class=\"asset-title\" data-bd=\"title\" data-l10n=\"feature.title\">Acme Fit</h1>\n    <p class=\"asset-sub\" data-bd=\"sub\" data-l10n=\"feature.sub\">Your week of runs, rides and rest</p>\n  </div>\n</main>\n"
 }
}
