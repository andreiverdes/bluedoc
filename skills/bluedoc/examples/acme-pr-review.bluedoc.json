              "hunks": [
                {
                  "old": 0,
                  "new": 1,
                  "lines": [
                    "+// Bulk discount tiers (PRICING-88).",
                    "+// Spec: 10 or more units of one SKU get 5 %, 50 or more get 10 %.",
                    "+import type { CartLine } from \"../orders/types\";",
                    "+",
                    "+export interface Tier {",
                    "+  minQty: number;",
                    "+  percent: number;",
                    "+}",
                    "+",
                    "+export const TIERS: Tier[] = [",
                    "+  { minQty: 50, percent: 10 },",
                    "+  { minQty: 10, percent: 5 },",
                    "+];",
                    "+",
                    "+/** The tier a line qualifies for, or undefined. */",
                    "+export function tierFor(qty: number): Tier | undefined {",
                    "+  return TIERS.find((t) => qty > t.minQty);",
                    "+}",
                    "+",
                    "+/** Line total in cents after its bulk tier. */",
                    "+export function lineTotal(line: CartLine): number {",
                    "+  const tier = tierFor(line.qty);",
                    "+  const gross = line.unitCents * line.qty;",
                    "+  if (!tier) return gross;",
                    "+  return gross * (1 - tier.percent / 100);",
                    "+}"
                  ]
                }
              ]
            },
