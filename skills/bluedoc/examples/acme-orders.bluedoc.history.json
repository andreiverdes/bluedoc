  "ea70b47c4f5c9f70": {
   "type": "table",
   "columns": [
    "Symptom",
    "Cause",
    "Fix"
   ],
   "rows": [
    [
     "Order exists, no pick ticket",
     "The outbox relay stopped; rows pile up in `outbox`.",
     "Run `SELECT count(*) FROM outbox;`. If it grows, restart orders-api and read the relay log."
    ],
    [
     "Worker log: `rebalancing` every few seconds",
     "A handler takes longer than `max.poll.interval.ms` (300 s).",
     "Find the slow WMS call; the worker commits only after the ticket exists."
    ],
    [
     "Two tickets for one order",
     "The WMS stub ignores the `Idempotency-Key` header.",
     "Use `wms-stub` 2.3 or later."
    ],
    [
     "`seed-orders.py` exits with `NoBrokersAvailable`",
     "Kafka is not up yet.",
     "Wait for `docker compose ps` to show `running`, then seed again."
    ]
   ]
  },
  "4bde5e772a42f780": {
   "type": "callout",
   "kind": "risk",
   "title": "Relay lag hides failures",
   "md": "The relay retries a failing publish forever. A broken broker shows up as a growing `outbox` table, not as an error. Alert on `outbox` row count above 1,000."
  },
  "600e38a7d85b6127": {
   "type": "callout",
   "kind": "decision",
   "md": "We keep the outbox instead of publishing from the request handler. A crash between commit and publish would otherwise lose the event."
  }
 }
}
