  "fe217bb0c38b6fc0": {
   "type": "terms",
   "items": [
    {
     "term": "order",
     "md": "One row in `orders`, created by `POST /orders`. Its id is the Kafka message key."
    },
    {
     "term": "outbox",
     "md": "The `outbox` table. A row is written in the same transaction as its order and deleted after the relay publishes it."
    },
    {
     "term": "pick ticket",
     "md": "The warehouse's work item for one order. The WMS returns its id; we store it on the order."
    },
    {
     "term": "idempotency key",
     "md": "A UUID the shop sends in `Idempotency-Key`. A repeat with the same key returns the first order."
    }
   ]
  },
  "c46261b22eb40de0": {
   "type": "cards",
   "items": [
    {
     "title": "Seeder",
     "tag": "recommended",
     "kind": "ok",
     "md": "Publish synthetic events with `scripts/seed-orders.py`. Exercises the worker and the WMS stub; skips PayCo and Postgres."
    },
    {
     "title": "Full local stack",
     "tag": "slower",
     "kind": "info",
     "md": "Run orders-api against the PayCo sandbox. Exercises the outbox relay too. Needs a sandbox key from the payments team."
    },
    {
     "title": "Replay from staging",
     "tag": "read-only data",
     "kind": "warn",
     "md": "Copy events from the staging topic with `kcat`. Real shapes, but customer data: never paste them into tickets."
    }
   ]
  },
