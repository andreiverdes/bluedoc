 "html": {
  "4b47cd11b304d852": "<main class=\"screen round safe stack center gap-2\" data-bd=\"face\">\n  <div class=\"wf-box\" data-label=\"Steps ring, 72 %\" data-bd=\"steps-ring\"></div>\n  <div class=\"display num\" data-bd=\"time\">10:09</div>\n  <div class=\"wf-text\" style=\"--lines:1\" data-bd=\"date\"></div>\n  <div class=\"row gap-4\">\n    <div class=\"wf-box\" data-label=\"Steps\" data-bd=\"steps\"></div>\n    <div class=\"wf-box\" data-label=\"Heart rate\" data-bd=\"heart\"></div>\n  </div>\n</main>\n",
  "5e5e831578bc1cf1": "<main class=\"screen safe stack gap-4\" data-bd=\"login\">\n  <div class=\"wf-circle\" data-bd=\"brand\"></div>\n  <h1 class=\"title\">Welcome back</h1>\n  <div class=\"wf-text\" style=\"--lines:2\"></div>\n  <div class=\"wf-box\" data-label=\"Email\" data-bd=\"email\"></div>\n  <div class=\"wf-box\" data-label=\"Password\" data-bd=\"password\"></div>\n  <button class=\"btn primary block\" data-bd=\"submit\">Sign in</button>\n  <button class=\"btn ghost sm\" data-bd=\"forgot\">Forgot your password?</button>\n</main>\n",
  "7ed68839feb5957d": "<main class=\"screen safe stack gap-5\" data-bd=\"dashboard\">\n  <header class=\"row between\" data-bd=\"top\"><strong>Acme Fit</strong><button class=\"btn sm\" data-bd=\"export\">Export CSV</button></header>\n  <section class=\"grid cols-4 gap-4\" data-bd=\"kpis\">\n    <div class=\"wf-box\" data-label=\"Steps today + 7-day trend\" data-bd=\"steps\"></div>\n    <div class=\"wf-box\" data-label=\"Active minutes\" data-bd=\"active\"></div>\n    <div class=\"wf-box\" data-label=\"Resting heart rate\" data-bd=\"heart\"></div>\n    <div class=\"wf-box\" data-label=\"Weekly goal ring\" data-bd=\"goal\"></div>\n  </section>\n  <section class=\"stack gap-2\" data-bd=\"workouts\">\n    <h2 class=\"headline\">Recent workouts</h2>\n    <div class=\"wf-line\"></div><div class=\"wf-line\"></div><div class=\"wf-line\"></div>\n  </section>\n</main>\n",
  "6ff2fbecf4147f32": "<style>\n  .face { --bg: #000; --fg: #fff; --muted: #9ca3af; --border: #1f2937; }\n  .face .ring { --size: 224px; --thick: 10px; }\n  .face .display { font-size: 52px; }\n</style>\n<main class=\"screen round stack center face\" data-bd=\"face\">\n  <div class=\"ring\" style=\"--v:.72\" data-bd=\"steps-ring\">\n    <div class=\"stack center gap-1\">\n      <div class=\"display num\" data-bd=\"time\">10:09</div>\n      <div class=\"caption muted\" data-bd=\"date\">Sat 10 Oct</div>\n      <div class=\"row gap-4\">\n        <div class=\"stack center\" data-bd=\"steps\"><span class=\"num\">7,214</span><span class=\"caption muted\">steps</span></div>\n        <div class=\"stack center\" data-bd=\"heart\"><span class=\"num\">68</span><span class=\"caption muted\">bpm</span></div>\n      </div>\n    </div>\n  </div>\n</main>\n",
  "80b7002f2be41ec0": "<main class=\"screen safe stack gap-4\" data-bd=\"login\">\n  <div class=\"stack gap-2\" data-bd=\"brand\">\n    <span class=\"badge\">Acme Fit</span>\n    <h1 class=\"title\">Welcome back</h1>\n    <p class=\"body muted\">Sign in to sync today's steps and workouts.</p>\n  </div>\n  <label class=\"stack gap-1\"><span class=\"label\">Email</span>\n    <input class=\"field\" type=\"email\" placeholder=\"you@acme.test\" data-bd=\"email\">\n  </label>\n  <label class=\"stack gap-1\"><span class=\"label\">Password</span>\n    <input class=\"field\" type=\"password\" placeholder=\"••••••••\" data-bd=\"password\">\n  </label>\n  <button class=\"btn primary block\" data-bd=\"submit\">Sign in</button>\n  <button class=\"btn block\" data-bd=\"passkey\">Use a passkey</button>\n  <button class=\"btn ghost sm\" data-bd=\"forgot\">Forgot your password?</button>\n</main>\n",
  "3db4ecdeb791aef6": "<main class=\"screen safe stack gap-4\" data-bd=\"login\">\n  <div class=\"wf-circle\" data-label=\"Logo\" data-bd=\"logo\"></div>\n  <div class=\"wf-text\" style=\"--lines:2\" data-bd=\"headline\"></div>\n  <button class=\"btn primary block\" data-bd=\"passkey\">Sign in with a passkey</button>\n  <div class=\"wf-line\" data-bd=\"divider\"></div>\n  <div class=\"wf-box\" data-label=\"Email field\" data-bd=\"email\"></div>\n  <button class=\"btn block\" data-bd=\"submit\">Use email instead</button>\n</main>\n",
  "f19cba082608b7af": "<div id=\"root\" data-bd=\"dashboard\"></div>\n<script>\nconst e = React.createElement, { HorizonProvider, Card, Stat, ProgressRing, Tag, Button } = HorizonUI;\nconst days = [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"];\nconst week = [6200, 8100, 7400, 9900, 5300, 11200, 7214];\nconst workouts = [[\"Morning run\", \"5.2 km\", \"28 min\"], [\"Strength\", \"6 sets\", \"41 min\"], [\"Evening walk\", \"3.1 km\", \"35 min\"],\n  [\"Cycling\", \"18.4 km\", \"52 min\"], [\"Yoga\", \"1 class\", \"30 min\"]];\nconst named = (bd, ...kids) => e('div', { 'data-bd': bd }, ...kids);\nconst bars = e('div', { className: 'acme-bars' }, week.map((v, i) => e('div', { key: days[i], className: 'acme-bar' },\n  e('span', { style: { height: `${Math.round(v / 120)}px` } }), e('small', null, days[i]))));\nReactDOM.createRoot(document.getElementById('root')).render(\n  e(HorizonProvider, { theme: 'light', className: 'acme-dash' },\n    e('header', { className: 'acme-top', 'data-bd': 'top' },\n      e('strong', null, 'Acme Fit'), e(Tag, null, 'Week 41'), e('span', { className: 'acme-grow' }),\n      named('export', e(Button, { variant: 'secondary' }, 'Export CSV'))),\n    e('section', { className: 'acme-stats', 'data-bd': 'kpis' },\n      named('steps', e(Card, null, e(Stat, { label: 'Steps today', value: '7,214', delta: 4.2, spark: week }))),\n      named('active', e(Card, null, e(Stat, { label: 'Active minutes', value: '104', unit: 'min', delta: 12.5 }))),\n      named('heart', e(Card, null, e(Stat, { label: 'Resting heart rate', value: '58', unit: 'bpm', delta: -1.7, tone: 'success' }))),\n      named('goal', e(Card, null, e('div', { className: 'acme-goal' }, e(ProgressRing, { value: 72, size: 64, stroke: 6 }),\n        e('div', null, e('strong', null, 'Weekly goal'), e('p', null, '50,500 of 70,000 steps')))))),\n    e('section', { className: 'acme-split' },\n      named('week', e(Card, { title: 'Steps this week' }, bars)),\n      named('workouts', e(Card, { title: 'Recent workouts' },\n        e('table', { className: 'acme-table' }, e('tbody', null,\n          workouts.map(([name, dist, time]) => e('tr', { key: name }, e('td', null, name), e('td', null, dist), e('td', null, time))))))))));\n</script>\n<style>\n  .acme-dash { min-height: 100vh; padding: 24px; display: grid; gap: 20px; align-content: start; }\n  .acme-top { display: flex; align-items: center; gap: 12px; font-size: 18px; }\n  .acme-grow { flex: 1; }\n  .acme-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }\n  .acme-stats > div > * { height: 100%; }\n  .acme-goal { display: flex; align-items: center; gap: 16px; }\n  .acme-goal p { margin: 4px 0 0; color: var(--hz-fg-muted, #6b7280); font-size: 13px; }\n  .acme-split { display: grid; grid-template-columns: 3fr 2fr; gap: 16px; }\n  .acme-split > div > * { height: 100%; }\n  .acme-bars { display: flex; align-items: flex-end; gap: 16px; height: 140px; padding-top: 12px; }\n  .acme-bar { flex: 1; display: grid; justify-items: center; gap: 6px; }\n  .acme-bar span { width: 100%; max-width: 48px; border-radius: 6px 6px 2px 2px; background: var(--accent, #4f46e5); }\n  .acme-bar small { color: var(--hz-fg-muted, #6b7280); font-size: 12px; }\n  .acme-table { width: 100%; border-collapse: collapse; }\n  .acme-table td { padding: 10px 0; border-top: 1px solid var(--hz-border, #e5e7eb); }\n  .acme-table td + td { text-align: right; color: var(--hz-fg-muted, #6b7280); }\n</style>\n"
 }
