  "6d2b5b497bb6d5e5": "<style>\n  .wo-time { font-size: 64px; line-height: 1; font-weight: 700; letter-spacing: -.02em; }\n</style>\n<main class=\"screen stack\" data-bd=\"workout\">\n  <header class=\"topbar\" data-bd=\"bar\">\n    <button class=\"btn ghost icon\" data-bd=\"back\" data-nav=\"back\" data-nav-label=\"Tap Back\" aria-label=\"Back\">‹</button>\n    <span class=\"headline grow\">Morning run</span>\n    <span class=\"badge ok\">Live</span>\n  </header>\n  <div class=\"stack gap-5 p-6\">\n    <section class=\"stack center gap-2\" data-bd=\"timer\">\n      <span class=\"label\">Elapsed</span>\n      <span class=\"wo-time num\">28:14</span>\n      <span class=\"caption muted\">Started 07:12</span>\n    </section>\n    <section class=\"grid cols-3 gap-3\" data-bd=\"stats\">\n      <div class=\"card kpi\" data-bd=\"distance\"><span class=\"label\">Distance</span><span class=\"num\">5.2</span><span class=\"caption muted\">km</span></div>\n      <div class=\"card kpi\" data-bd=\"pace\"><span class=\"label\">Pace</span><span class=\"num\">5:26</span><span class=\"caption muted\">/km</span></div>\n      <div class=\"card kpi\" data-bd=\"heart\"><span class=\"label\">Heart</span><span class=\"num\">146</span><span class=\"caption muted\">bpm</span></div>\n    </section>\n    <section class=\"stack gap-2\" data-bd=\"goal\">\n      <div class=\"row between\"><span class=\"body\">Goal 6 km</span><span class=\"num\">87%</span></div>\n      <div class=\"progress\"><span style=\"--v:.87\"></span></div>\n    </section>\n    <div class=\"row gap-3\" data-bd=\"controls\">\n      <button class=\"btn grow\" data-bd=\"pause\">Pause</button>\n      <button class=\"btn danger grow\" data-bd=\"end\">End workout</button>\n    </div>\n  </div>\n  <i hidden data-bd=\"edge-back\" data-nav=\"back\" data-nav-label=\"Swipe from the left edge\"></i>\n</main>\n",
  "e5f164ece313a6a9": "<style>\n  .pro-avatar { width: 72px; height: 72px; font-size: 26px; }\n</style>\n<main class=\"screen safe stack gap-4\" data-bd=\"profile\">\n  <header class=\"row between\" data-bd=\"head\">\n    <h1 class=\"title\">Profile</h1>\n    <button class=\"btn ghost icon\" data-bd=\"open-settings\" data-nav=\"modal:settings\" data-nav-label=\"Tap the gear\" aria-label=\"Settings\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1\"/></svg></button>\n  </header>\n  <section class=\"row gap-4\" data-bd=\"who\">\n    <span class=\"avatar pro-avatar\">AF</span>\n    <div class=\"stack gap-1\">\n      <strong class=\"headline\">Acme Fit member</strong>\n      <span class=\"caption muted\">you@acme.test · since March</span>\n    </div>\n  </section>\n  <section class=\"grid cols-3 gap-3\" data-bd=\"totals\">\n    <div class=\"card kpi\"><span class=\"label\">Workouts</span><span class=\"num\">128</span></div>\n    <div class=\"card kpi\"><span class=\"label\">Streak</span><span class=\"num\">12 d</span></div>\n    <div class=\"card kpi\"><span class=\"label\">Best day</span><span class=\"num\">14.2k</span></div>\n  </section>\n  <section class=\"card list\" data-bd=\"more\">\n    <div class=\"item between\" data-bd=\"goals\"><span>Daily goal</span><span class=\"muted\">10,000 steps ›</span></div>\n    <div class=\"item between\" data-bd=\"devices\"><span>Devices</span><span class=\"muted\">Acme Watch ›</span></div>\n    <div class=\"item between\" data-bd=\"friends\"><span>Friends</span><span class=\"muted\">8 ›</span></div>\n  </section>\n  <nav class=\"tabbar\" data-bd=\"tabs\">\n    <a class=\"tab\" data-bd=\"tab-today\" data-nav=\"tab:today\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" st