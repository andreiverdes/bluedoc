  "e2c332cfaf49c704": "<style>\n  .act-bars { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; align-items: end; height: 148px; }\n  .act-bars > div { display: flex; flex-direction: column; align-items: center; gap: 6px; }\n  .act-bars span { display: block; width: 100%; border-radius: 6px 6px 2px 2px; background: color-mix(in srgb, var(--accent) 35%, var(--surface)); }\n  .act-bars .now span { background: var(--accent); }\n</style>\n<main class=\"screen safe stack gap-4\" data-bd=\"activity\">\n  <h1 class=\"title\">Activity</h1>\n  <div class=\"row gap-2\" data-bd=\"range\">\n    <span class=\"chip\">Day</span><span class=\"chip active\">Week</span><span class=\"chip\">Month</span>\n  </div>\n  <section class=\"card stack gap-3\" data-bd=\"week\">\n    <div class=\"row between\"><span class=\"headline\">Steps this week</span><span class=\"num\">55,314</span></div>\n    <div class=\"act-bars\">\n      <div><span style=\"height:78px\"></span><small class=\"caption muted\">M</small></div>\n      <div><span style=\"height:101px\"></span><small class=\"caption muted\">T</small></div>\n      <div><span style=\"height:92px\"></span><small class=\"caption muted\">W</small></div>\n      <div><span style=\"height:124px\"></span><small class=\"caption muted\">T</small></div>\n      <div><span style=\"height:66px\"></span><small class=\"caption muted\">F</small></div>\n      <div class=\"now\"><span style=\"height:90px\"></span><small class=\"caption muted\">S</small></div>\n      <div><span style=\"height:4px\"></span><small class=\"caption muted\">S</small></div>\n    </div>\n  </section>\n  <section class=\"card list\" data-bd=\"totals\">\n    <div class=\"item between\"><span>Active minutes</span><span class=\"num\">286</span></div>\n    <div class=\"item between\"><span>Distance</span><span class=\"num\">38.2 km</span></div>\n    <div class=\"item between\"><span>Resting heart rate</span><span class=\"num\">58 bpm</span></div>\n  </section>\n  <nav class=\