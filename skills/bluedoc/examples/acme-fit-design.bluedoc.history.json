  "b8e13ef3f377fdae": "<style>\n  .today-ring { --size: 176px; --thick: 14px; }\n  .today-ring .num { font-size: 36px; line-height: 1.1; }\n</style>\n<main class=\"screen safe stack gap-4\" data-bd=\"today\">\n  <header class=\"row between\" data-bd=\"greeting\">\n    <div class=\"stack gap-1\">\n      <span class=\"caption muted\">Saturday 10 October</span>\n      <h1 class=\"title\">Today</h1>\n    </div>\n    <span class=\"avatar\" data-bd=\"avatar\">AF</span>\n  </header>\n  <section class=\"card stack center gap-3\" data-bd=\"steps\">\n    <div class=\"ring today-ring\" style=\"--v:.72\">\n      <div class=\"stack center\">\n        <span class=\"num\">7,214</span>\n        <span class=\"caption muted\">of 10,000 steps</span>\n      </div>\n    </div>\n    <span class=\"badge ok\">72% of your goal</span>\n  </section>\n  <section class=\"grid cols-3 gap-3\" data-bd=\"stats\">\n    <div class=\"card kpi\" data-bd=\"active\"><span class=\"label\">Active</span><span class=\"num\">42</span><span class=\"caption muted\">min</span></div>\n    <div class=\"card kpi\" data-bd=\"heart\"><span class=\"label\">Heart</span><span class=\"num\">68</span><span class=\"caption muted\">bpm</span></div>\n    <div class=\"card kpi\" data-bd=\"distance\"><span class=\"label\">Distance</span><span class=\"num\">5.4</span><span class=\"caption muted\">km</span></div>\n  </section>\n  <button class=\"btn primary block\" data-bd=\"start-workout\" data-nav=\"workout\" data-nav-label=\"Tap Start workout\">Start workout</button>\n  <nav class=\"tabbar\" data-bd=\"tabs\">\n    <a class=\"tab active\" data-bd=\"tab-today\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"/></svg>Today</a>\n    <a class=\"tab\" data-bd=\"tab-activity\" data-nav=\"tab:activity\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\